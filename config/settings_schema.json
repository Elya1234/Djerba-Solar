[
  {
    "name": "theme_info",
    "theme_name": "Gold Mines — By Orpaz",
    "theme_version": "1.0.0",
    "theme_author": "Gold Mines",
    "theme_documentation_url": "https://github.com/Elya1234/Djerba-Solar",
    "theme_support_email": "goldminesshop5@gmail.com"
  },
  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.typography.headings"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "default": "ebgaramond_n4",
        "label": "t:settings.typography.heading_font"
      },
      {
        "type": "header",
        "content": "t:settings.typography.body"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "default": "assistant_n4",
        "label": "t:settings.typography.body_font"
      }
    ]
  },
  {
    "name": "t:settings.colors.name",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "t:settings.colors.bg",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "t:settings.colors.text",
        "default": "#0A0A0B"
      },
      {
        "type": "color",
        "id": "color_navy",
        "label": "t:settings.colors.navy",
        "default": "#0A1A2B"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "t:settings.colors.gold",
        "default": "#B7975C"
      },
      {
        "type": "color",
        "id": "color_stone",
        "label": "t:settings.colors.stone",
        "default": "#CBBFA5"
      }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "t:settings.layout.page_width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "select",
        "id": "header_style",
        "label": "t:settings.layout.header_style",
        "options": [
          { "value": "transparent", "label": "t:settings.layout.header_transparent" },
          { "value": "solid", "label": "t:settings.layout.header_solid" }
        ],
        "default": "transparent"
      }
    ]
  },
  {
    "name": "t:settings.motion.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "t:settings.motion.enable_animations",
        "default": true,
        "info": "t:settings.motion.enable_animations_info"
      }
    ]
  },
  {
    "name": "t:settings.social.name",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram" },
      { "type": "text", "id": "social_facebook", "label": "Facebook" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest" },
      { "type": "text", "id": "social_whatsapp", "label": "t:settings.social.whatsapp_number" }
    ]
  },
  {
    "name": "t:settings.contact.name",
    "settings": [
      { "type": "text", "id": "shop_phone", "label": "t:settings.contact.phone" },
      { "type": "text", "id": "shop_address", "label": "t:settings.contact.address" },
      { "type": "richtext", "id": "shop_hours", "label": "t:settings.contact.hours" }
    ]
  },
  {
    "name": "t:settings.favicon.name",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "t:settings.favicon.image" }
    ]
  }
]
