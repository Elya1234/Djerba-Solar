{{ 'homepage.css' | asset_url | stylesheet_tag }}

<section class="gm-section">
  <div class="gm-container gm-story{% if section.settings.image_position == 'right' %} gm-story--reverse{% endif %}" data-gm-reveal="fade">
    <div class="gm-story__media">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1200x' }}
      {%- elsif section.settings.image -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {%- endif -%}
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="gm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="gm-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="gm-lead" style="margin-top:var(--space-4);">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="gm-btn gm-btn--outline" style="margin-top:var(--space-5);">{{ section.settings.link_label }}</a>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="gm-story__stats">
          {%- for block in section.blocks -%}
            <div class="gm-story__stat" {{ block.shopify_attributes }}>
              <div class="num">{{ block.settings.number }}</div>
              <div class="lab">{{ block.settings.label }}</div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Éditorial (image + texte)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Vidéo (prioritaire sur l'image)" },
    { "type": "select", "id": "image_position", "label": "Position de l'image", "options": [ { "value": "left", "label": "Gauche" }, { "value": "right", "label": "Droite" } ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Titre de la section" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "link_label", "label": "Libellé du lien" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Chiffre clé",
      "settings": [
        { "type": "text", "id": "number", "label": "Chiffre", "default": "100%" },
        { "type": "text", "id": "label", "label": "Légende", "default": "Fabrication artisanale" }
      ]
    }
  ],
  "presets": [{ "name": "Éditorial (image + texte)" }]
}
{% endschema %}
