{{ 'pages.css' | asset_url | stylesheet_tag }}
{{ 'account.css' | asset_url | stylesheet_tag }}
<script src="{{ 'contact-form.js' | asset_url }}" defer="defer"></script>

<div class="gm-container gm-section">
  <div class="gm-auth">
    <div class="gm-auth__head">
      <span class="gm-eyebrow">{{ 'customer.reset_password.eyebrow' | t }}</span>
      <h1 class="gm-h2">{{ 'customer.reset_password.heading' | t }}</h1>
      <p class="gm-lead">{{ 'customer.reset_password.subheading' | t }}</p>
    </div>

    {%- form 'reset_customer_password', id: 'ResetPasswordForm', class: 'gm-form' -%}
      {%- if form.errors -%}
        <div class="gm-form__notice gm-form__notice--error" role="alert">
          {{ 'customer.reset_password.error' | t }}
        </div>
      {%- endif -%}

      <div class="gm-form__field" data-invalid="{% if form.errors contains 'password' %}true{% else %}false{% endif %}">
        <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <div class="gm-password-field">
          <input type="password" class="gm-input" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
          <button type="button" class="gm-password-toggle" data-gm-password-toggle="ResetPassword" data-label-show="{{ 'customer.login.show_password' | t }}" data-label-hide="{{ 'customer.login.hide_password' | t }}" aria-pressed="false">{{ 'customer.login.show_password' | t }}</button>
        </div>
      </div>

      <div class="gm-form__field" data-invalid="{% if form.errors contains 'password_confirmation' %}true{% else %}false{% endif %}">
        <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <div class="gm-password-field">
          <input type="password" class="gm-input" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
          <button type="button" class="gm-password-toggle" data-gm-password-toggle="ResetPasswordConfirm" data-label-show="{{ 'customer.login.show_password' | t }}" data-label-hide="{{ 'customer.login.hide_password' | t }}" aria-pressed="false">{{ 'customer.login.show_password' | t }}</button>
        </div>
      </div>

      <div class="gm-form__submit-row">
        <button type="submit" class="gm-btn gm-btn--primary gm-btn--full" data-gm-form-submit>{{ 'customer.reset_password.submit' | t }}</button>
        <span class="gm-form__error" data-gm-form-client-error hidden></span>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Nouveau mot de passe",
  "settings": []
}
{% endschema %}
