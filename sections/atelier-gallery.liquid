{{ 'homepage.css' | asset_url | stylesheet_tag }}

<section class="gm-section gm-theme-dark" style="background:var(--gm-navy-900); color:var(--gm-white);">
  <div class="gm-container">
    <div style="max-width:60rem; margin-bottom:var(--space-6);" data-gm-reveal="fade">
      {%- if section.settings.eyebrow != blank -%}<span class="gm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="gm-h2" style="color:var(--gm-white);">{{ section.settings.heading | default: "L'Atelier" }}</h2>
      {%- if section.settings.text != blank -%}<p class="gm-lead" style="color:rgba(255,255,255,0.72); margin-top:var(--space-3);">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="gm-gallery" data-gm-reveal="fade">
      {%- for block in section.blocks -%}
        <div class="gm-gallery__item gm-gallery__item--{{ block.settings.size }}" {{ block.shopify_attributes }}>
          {%- if block.settings.video -%}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
          {%- elsif block.settings.image -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Atelier Gold Mines' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Atelier (galerie)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Artisanat" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "L'Atelier" },
    { "type": "textarea", "id": "text", "label": "Texte" }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Média",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Vidéo (prioritaire sur l'image)" },
        { "type": "select", "id": "size", "label": "Taille dans la grille", "options": [ { "value": "wide", "label": "Large" }, { "value": "tall", "label": "Haute" }, { "value": "small", "label": "Petite" } ], "default": "small" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atelier (galerie)",
      "blocks": [
        { "type": "media", "settings": { "size": "wide" } },
        { "type": "media", "settings": { "size": "tall" } },
        { "type": "media", "settings": { "size": "small" } },
        { "type": "media", "settings": { "size": "small" } }
      ]
    }
  ]
}
{% endschema %}
