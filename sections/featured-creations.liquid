{{ 'homepage.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = collections[section.settings.collection]
-%}

<section class="gm-section">
  <div class="gm-container">
    <div class="gm-creations__head" data-gm-reveal="fade">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="gm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="gm-h2">{{ section.settings.heading | default: 'Créations emblématiques' }}</h2>
      </div>
      {%- if collection -%}
        <a href="{{ collection.url }}" class="gm-btn gm-btn--ghost">Voir la collection</a>
      {%- endif -%}
    </div>

    <div class="gm-creations__track" data-gm-reveal="fade">
      {%- if collection -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          <article class="gm-creations__item">
            <a href="{{ product.url }}" class="gm-creations__media">
              {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}
              {%- if product.images[1] -%}
                {{ product.images[1] | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title, class: 'gm-creations__hover' }}
              {%- endif -%}
            </a>
            <div class="gm-creations__meta">
              <a href="{{ product.url }}" class="gm-name">{{ product.title }}</a>
              <div class="gm-price">
                {%- if product.price_varies -%}À partir de {{ product.price_min | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
              </div>
            </div>
          </article>
        {%- else -%}
          <p class="gm-lead">Ajoutez des produits à la collection « {{ section.settings.collection }} » pour les afficher ici.</p>
        {%- endfor -%}
      {%- else -%}
        <p class="gm-lead">Sélectionnez une collection dans les réglages de cette section.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Créations emblématiques",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Signature" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Créations emblématiques" },
    { "type": "collection", "id": "collection", "label": "Collection à mettre en avant" },
    { "type": "range", "id": "limit", "label": "Nombre de créations", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Créations emblématiques" }]
}
{% endschema %}
