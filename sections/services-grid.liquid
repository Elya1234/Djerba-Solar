<section class="gm-section">
  <div class="gm-container">
    <div style="max-width:60rem; margin-bottom:var(--space-6);" data-gm-reveal="fade">
      {%- if section.settings.eyebrow != blank -%}<span class="gm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="gm-h2">{{ section.settings.heading | default: 'Services' }}</h2>
    </div>
    <div class="gm-services__grid" data-gm-reveal="fade">
      {%- for block in section.blocks -%}
        <div class="gm-services__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <div class="gm-services__image">{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}</div>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="gm-btn gm-btn--ghost" style="padding-left:0;">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Services",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "À votre service" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos services" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (optionnelle)" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Création sur mesure" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services",
      "blocks": [
        { "type": "service", "settings": { "title": "Création sur mesure" } },
        { "type": "service", "settings": { "title": "Transformation" } },
        { "type": "service", "settings": { "title": "Réparation" } },
        { "type": "service", "settings": { "title": "Mise à taille" } },
        { "type": "service", "settings": { "title": "Gravure" } },
        { "type": "service", "settings": { "title": "Rhodiage & entretien" } }
      ]
    }
  ]
}
{% endschema %}
