{{ 'pages.css' | asset_url | stylesheet_tag }}

<section class="gm-cta-banner">
  <div class="gm-container gm-cta-banner__inner" data-gm-reveal="fade">
    {%- if section.settings.eyebrow != blank -%}<span class="gm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="gm-h2" style="color:var(--gm-white);">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="gm-lead" style="color:rgba(255,255,255,0.75); margin-top:var(--space-3);">{{ section.settings.text }}</p>{%- endif -%}

    {%- liquid
      assign has_buttons = false
      for block in section.blocks
        if block.settings.label != blank and block.settings.link != blank
          assign has_buttons = true
        endif
      endfor
    -%}
    {%- if has_buttons -%}
      <div class="gm-cta-banner__actions">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank and block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="gm-btn {% if forloop.index0 == 0 %}gm-btn--primary{% else %}gm-btn--outline{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bannière CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Prenez rendez-vous avec la Maison" },
    { "type": "textarea", "id": "text", "label": "Texte" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Bouton",
      "settings": [
        { "type": "text", "id": "label", "label": "Libellé" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bannière CTA",
      "blocks": [
        { "type": "button", "settings": { "label": "Prendre rendez-vous" } },
        { "type": "button", "settings": { "label": "Nous contacter" } }
      ]
    }
  ]
}
{% endschema %}
