{{ 'homepage.css' | asset_url | stylesheet_tag }}

{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <section class="gm-section--tight gm-container" data-gm-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}">
    <div class="gm-creations__head" data-gm-reveal="fade">
      <h2 class="gm-h2">{{ section.settings.heading | default: 'Vous pourriez aussi aimer' }}</h2>
    </div>
    <div class="gm-creations__track" data-gm-reveal="fade">
      {%- for recommended_product in recommendations.products -%}
        <div class="gm-creations__item">{% render 'product-card', product: recommended_product %}</div>
      {%- endfor -%}
    </div>
  </section>
{%- elsif product -%}
  <section class="gm-section--tight gm-container" data-gm-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}">
    <div class="gm-creations__head"><h2 class="gm-h2">{{ section.settings.heading | default: 'Vous pourriez aussi aimer' }}</h2></div>
    <div class="gm-creations__track"></div>
  </section>
{%- endif -%}

<script src="{{ 'recommendations.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Recommandations produits",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vous pourriez aussi aimer" },
    { "type": "select", "id": "intent", "label": "Type de recommandation", "options": [ { "value": "related", "label": "Similaires (Vous pourriez aussi aimer)" }, { "value": "complementary", "label": "Complémentaires (À associer avec)" } ], "default": "related" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [
    { "name": "Vous pourriez aussi aimer", "settings": { "heading": "Vous pourriez aussi aimer", "intent": "related" } },
    { "name": "À associer avec", "settings": { "heading": "À associer avec", "intent": "complementary" } }
  ]
}
{% endschema %}
