{{ 'homepage.css' | asset_url | stylesheet_tag }}

<section class="gm-section">
  <div class="gm-container">
    <div style="max-width:60rem; margin-bottom:var(--space-7);" data-gm-reveal="fade">
      {%- if section.settings.eyebrow != blank -%}<span class="gm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="gm-h2">{{ section.settings.heading | default: 'Savoir-faire' }}</h2>
    </div>
    <div class="gm-timeline" data-gm-reveal="fade">
      {%- for block in section.blocks -%}
        <div class="gm-timeline__step" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Savoir-faire (étapes)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Notre savoir-faire" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "De l'idée au bijou" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Croquis" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Savoir-faire (étapes)",
      "blocks": [
        { "type": "step", "settings": { "title": "Croquis" } },
        { "type": "step", "settings": { "title": "Conception 3D" } },
        { "type": "step", "settings": { "title": "Fabrication" } },
        { "type": "step", "settings": { "title": "Sertissage" } },
        { "type": "step", "settings": { "title": "Polissage" } },
        { "type": "step", "settings": { "title": "Contrôle qualité" } }
      ]
    }
  ]
}
{% endschema %}
