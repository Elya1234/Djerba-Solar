{{ 'homepage.css' | asset_url | stylesheet_tag }}

<section class="gm-section gm-bg-soft" style="background:var(--gm-bg-soft);">
  <div class="gm-container">
    <div style="max-width:60rem; margin-bottom:var(--space-7);" data-gm-reveal="fade">
      {%- if section.settings.eyebrow != blank -%}<span class="gm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="gm-h2">{{ section.settings.heading | default: 'Diamants & pierres précieuses' }}</h2>
      {%- if section.settings.text != blank -%}<p class="gm-lead" style="margin-top:var(--space-3);">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="gm-universes__list" style="gap: var(--space-4);">
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px,1fr)); gap:var(--space-4);" data-gm-reveal="fade">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link }}" class="gm-hover-zoom" style="display:block; position:relative; aspect-ratio:3/4; border-radius:var(--radius-sm); overflow:hidden;" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- endif -%}
            <span style="position:absolute; inset:0; background:linear-gradient(0deg, rgba(10,10,11,0.65), transparent 55%);"></span>
            <span style="position:absolute; left:var(--space-3); bottom:var(--space-3); color:var(--gm-white); font-family:var(--font-display); font-size:1.8rem;">{{ block.settings.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.guide_link != blank -%}
      <div style="text-align:center; margin-top: var(--space-6);">
        <a href="{{ section.settings.guide_link }}" class="gm-btn gm-btn--outline">Consulter le guide des pierres</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Diamants & pierres",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "L'exception" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Diamants & pierres précieuses" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "url", "id": "guide_link", "label": "Lien vers le guide des pierres" }
  ],
  "blocks": [
    {
      "type": "gem",
      "name": "Pierre",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Nom", "default": "Diamant" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Diamants & pierres précieuses",
      "blocks": [
        { "type": "gem", "settings": { "title": "Diamant" } },
        { "type": "gem", "settings": { "title": "Saphir" } },
        { "type": "gem", "settings": { "title": "Rubis" } },
        { "type": "gem", "settings": { "title": "Émeraude" } }
      ]
    }
  ]
}
{% endschema %}
