{{ 'homepage.css' | asset_url | stylesheet_tag }}

<section class="gm-banner{% if section.settings.align == 'right' %} gm-banner--align-right{% endif %}">
  <div class="gm-banner__media">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.heading }}
    {%- endif -%}
  </div>
  <div class="gm-container">
    <div class="gm-banner__content" data-gm-reveal="fade">
      {%- if section.settings.eyebrow != blank -%}<span class="gm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="gm-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="gm-lead" style="color:rgba(255,255,255,0.82); margin-top:var(--space-3);">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <div style="margin-top: var(--space-5);">
          <a href="{{ section.settings.link }}" class="gm-btn gm-btn--outline" style="color:var(--gm-white);">{{ section.settings.link_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bannière immersive",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image plein écran" },
    { "type": "select", "id": "align", "label": "Alignement du texte", "options": [ { "value": "left", "label": "Gauche" }, { "value": "right", "label": "Droite" } ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fiançailles" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Imaginez la bague de votre histoire" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Créer ma bague" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "presets": [{ "name": "Bannière immersive" }]
}
{% endschema %}
