{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign per_row_editorial = section.settings.editorial_every | plus: 0
-%}

{%- if collection.image or collection.description != blank -%}
  <div class="gm-collection-banner{% unless collection.image %} gm-collection-banner--plain{% endunless %}">
    {%- if collection.image -%}
      <div class="gm-collection-banner__media">
        {{ collection.image | image_url: width: 2000 | image_tag: loading: 'eager', alt: collection.title }}
      </div>
    {%- endif -%}
    <div class="gm-container gm-collection-banner__content" data-gm-reveal="fade">
      <span class="gm-eyebrow">Collection</span>
      <h1 class="gm-h2"{% if collection.image %} style="color:var(--gm-white);"{% endif %}>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="gm-lead" style="{% if collection.image %}color:rgba(255,255,255,0.85);{% endif %} margin-top: var(--space-3); max-width:60ch;">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </div>
{%- else -%}
  <div class="gm-container" style="padding-top: var(--space-7);">
    <span class="gm-eyebrow">Collection</span>
    <h1 class="gm-h2">{{ collection.title }}</h1>
  </div>
{%- endif -%}

<div class="gm-container gm-section--tight">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="gm-toolbar">
      <button class="gm-toolbar__filter-btn" data-gm-filter-open aria-haspopup="dialog">
        {% render 'icon', name: 'menu', size: 16 %} Filtrer
      </button>
      <span class="gm-toolbar__count">{{ collection.products_count }} création{% if collection.products_count > 1 %}s{% endif %}</span>
      <div class="gm-toolbar__sort">
        <label class="gm-visually-hidden" for="SortBy">Trier par</label>
        <select id="SortBy" data-gm-sort-select form="FacetsFormDesktop" name="sort_by">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    <div class="gm-collection-layout">
      <aside class="gm-facets" aria-label="Filtres">
        {% render 'facets', results: collection, id: 'FacetsFormDesktop' %}
      </aside>

      <div>
        {%- if collection.products.size == 0 -%}
          <div class="gm-empty-state">
            <p class="gm-lead">Aucune création ne correspond à ces filtres pour le moment.</p>
            <a href="{{ collection.url }}" class="gm-btn gm-btn--outline" style="margin-top: var(--space-4);">Réinitialiser les filtres</a>
          </div>
        {%- else -%}
          <div class="gm-product-grid">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
              {%- if per_row_editorial > 0 and forloop.index0 > 0 and forloop.index0 | modulo: per_row_editorial == 0 -%}
                {%- assign editorial_index = forloop.index0 | divided_by: per_row_editorial | minus: 1 -%}
                {%- assign editorial_block = section.blocks[editorial_index] -%}
                {%- if editorial_block and editorial_block.type == 'editorial' -%}
                  <div class="gm-product-grid__editorial" {{ editorial_block.shopify_attributes }}>
                    <h3 class="gm-h3">{{ editorial_block.settings.heading }}</h3>
                    {%- if editorial_block.settings.text != blank -%}<p class="gm-lead">{{ editorial_block.settings.text }}</p>{%- endif -%}
                    {%- if editorial_block.settings.link_label != blank -%}
                      <a href="{{ editorial_block.settings.link }}" class="gm-btn gm-btn--ghost">{{ editorial_block.settings.link_label }}</a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="gm-pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Précédent</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span aria-current="page">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Suivant →</a>{%- endif -%}
          </nav>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
</div>

{%- comment -%} ---- Mobile filter drawer ---- {%- endcomment -%}
<div class="gm-filter-drawer" data-gm-filter-drawer role="dialog" aria-modal="true" aria-label="Filtrer les résultats">
  <div class="gm-filter-drawer__head">
    <span class="gm-h4">Filtrer</span>
    <button data-gm-filter-close aria-label="Fermer">{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="gm-filter-drawer__body">
    {% render 'facets', results: collection, id: 'FacetsFormMobile' %}
  </div>
</div>

<script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Collection — grille produits",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Produits par page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "select", "id": "editorial_every", "label": "Insérer un bloc éditorial toutes les…", "options": [ { "value": "0", "label": "Jamais" }, { "value": "8", "label": "8 produits" }, { "value": "12", "label": "12 produits" }, { "value": "16", "label": "16 produits" } ], "default": "0" }
  ],
  "blocks": [
    {
      "type": "editorial",
      "name": "Bloc éditorial",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Le saviez-vous ?" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ]
}
{% endschema %}
