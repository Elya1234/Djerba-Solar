{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign per_row_editorial = section.settings.editorial_every | plus: 0
  assign editorial_blocks = section.blocks | where: 'type', 'editorial'
  assign subcategory_blocks = section.blocks | where: 'type', 'subcategory'
  assign universe_blocks = section.blocks | where: 'type', 'universe'
  assign has_banner_content = false
  if collection.image or collection.description != blank
    assign has_banner_content = true
  endif
  assign show_banner = false
  if section.settings.show_banner and has_banner_content
    assign show_banner = true
  endif
-%}

{%- if show_banner -%}
  <div class="gm-collection-banner{% unless collection.image %} gm-collection-banner--plain{% endunless %}">
    {%- if collection.image -%}
      <div class="gm-collection-banner__media">
        {{ collection.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', alt: collection.title }}
      </div>
    {%- endif -%}
    <div class="gm-container gm-collection-banner__content" data-gm-reveal="fade">
      {% render 'breadcrumbs' %}
      <span class="gm-eyebrow">Collection</span>
      <h1 class="gm-h2"{% if collection.image %} style="color:var(--gm-white);"{% endif %}>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="gm-lead" style="{% if collection.image %}color:rgba(255,255,255,0.85);{% endif %} margin-top: var(--space-3); max-width:60ch;">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </div>
{%- else -%}
  <div class="gm-container" style="padding-top: var(--space-7);">
    {% render 'breadcrumbs' %}
    <span class="gm-eyebrow">Collection</span>
    <h1 class="gm-h2">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="gm-lead" style="margin-top: var(--space-3); max-width:60ch;">{{ collection.description }}</div>
    {%- endif -%}
  </div>
{%- endif -%}

<div class="gm-container gm-section--tight">
  {%- if subcategory_blocks.size > 0 -%}
    <div class="gm-subcats" data-gm-reveal="fade" role="list" aria-label="Sous-catégories">
      {%- for block in subcategory_blocks -%}
        <a href="{{ block.settings.link }}" class="gm-subcats__item" role="listitem" {{ block.shopify_attributes }}>
          <span class="gm-subcats__media">
            {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: block.settings.title }}{%- endif -%}
          </span>
          <span class="gm-subcats__label">{{ block.settings.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="gm-toolbar">
      <button class="gm-toolbar__filter-btn" data-gm-filter-open aria-haspopup="dialog" aria-controls="CollectionFilterDrawer">
        {% render 'icon', name: 'menu', size: 16 %} Filtrer
      </button>
      <span class="gm-toolbar__count" aria-live="polite">{{ collection.products_count }} création{% if collection.products_count > 1 %}s{% endif %}</span>
      <div class="gm-toolbar__sort">
        <label class="gm-visually-hidden" for="SortBy">Trier par</label>
        <select id="SortBy" data-gm-sort-select form="FacetsFormDesktop" name="sort_by">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    <div class="gm-collection-layout">
      <aside class="gm-facets" aria-label="Filtres">
        {% render 'facets', results: collection, id: 'FacetsFormDesktop' %}
      </aside>

      <div>
        {%- if collection.products.size == 0 -%}
          <div class="gm-empty-state">
            <p class="gm-lead">Aucune création ne correspond à ces filtres pour le moment.</p>
            <div style="display:flex; flex-wrap:wrap; gap:var(--space-3); justify-content:center; margin-top: var(--space-5);">
              <a href="{{ collection.url }}" class="gm-btn gm-btn--outline">Réinitialiser les filtres</a>
              <a href="{{ routes.all_products_collection_url }}" class="gm-btn gm-btn--outline">Voir toutes les créations</a>
              <a href="{{ routes.root_url }}collections" class="gm-btn gm-btn--ghost">Découvrir nos collections</a>
            </div>
          </div>
        {%- else -%}
          <div class="gm-product-grid">
            {%- for product in collection.products -%}
              {%- liquid
                assign is_priority_card = forloop.index0 < 4
                assign editorial_slot = false
                if per_row_editorial > 0 and forloop.index0 > 0
                  assign row_position = forloop.index0 | modulo: per_row_editorial
                  if row_position == 0
                    assign editorial_slot = true
                  endif
                endif
              -%}
              {% render 'product-card', product: product, priority: is_priority_card %}
              {%- if editorial_slot -%}
                {%- assign editorial_index = forloop.index0 | divided_by: per_row_editorial | minus: 1 -%}
                {%- assign editorial_block = editorial_blocks[editorial_index] -%}
                {%- if editorial_block -%}
                  <div class="gm-product-grid__editorial" {{ editorial_block.shopify_attributes }}>
                    <h3 class="gm-h3">{{ editorial_block.settings.heading }}</h3>
                    {%- if editorial_block.settings.text != blank -%}<p class="gm-lead">{{ editorial_block.settings.text }}</p>{%- endif -%}
                    {%- if editorial_block.settings.link_label != blank and editorial_block.settings.link != blank -%}
                      <a href="{{ editorial_block.settings.link }}" class="gm-btn gm-btn--ghost">{{ editorial_block.settings.link_label }}</a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="gm-pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Précédent</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span aria-current="page">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Suivant →</a>{%- endif -%}
          </nav>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}

  {%- if universe_blocks.size > 0 -%}
    <div class="gm-explore-more" data-gm-reveal="fade">
      {%- if section.settings.explore_heading != blank -%}<h2 class="gm-h3" style="margin-bottom:var(--space-5);">{{ section.settings.explore_heading }}</h2>{%- endif -%}
      <div class="gm-explore-more__grid">
        {%- for block in universe_blocks -%}
          <a href="{{ block.settings.link }}" class="gm-hover-zoom" style="display:block; position:relative; aspect-ratio:4/3; border-radius:var(--radius-sm); overflow:hidden;" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}{%- endif -%}
            <span style="position:absolute; inset:0; background:linear-gradient(0deg, rgba(10,10,11,0.6), transparent 55%);"></span>
            <span style="position:absolute; left:var(--space-3); bottom:var(--space-3); color:var(--gm-white); font-family:var(--font-display); font-size:1.8rem;">{{ block.settings.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{%- comment -%} ---- Mobile filter drawer ---- {%- endcomment -%}
<div class="gm-filter-drawer" id="CollectionFilterDrawer" data-gm-filter-drawer role="dialog" aria-modal="true" aria-label="Filtrer les résultats">
  <div class="gm-filter-drawer__head">
    <span class="gm-h4">Filtrer</span>
    <button data-gm-filter-close aria-label="Fermer">{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="gm-filter-drawer__body">
    {% render 'facets', results: collection, id: 'FacetsFormMobile' %}
  </div>
</div>

<script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Collection — grille produits",
  "settings": [
    { "type": "checkbox", "id": "show_banner", "label": "Afficher la bannière (image/description de la collection)", "default": true },
    { "type": "range", "id": "products_per_page", "label": "Produits par page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "select", "id": "editorial_every", "label": "Insérer un bloc éditorial toutes les…", "options": [ { "value": "0", "label": "Jamais" }, { "value": "8", "label": "8 produits" }, { "value": "12", "label": "12 produits" }, { "value": "16", "label": "16 produits" } ], "default": "0" },
    { "type": "text", "id": "explore_heading", "label": "Titre « Découvrir d'autres univers »", "default": "Explorer d'autres univers" }
  ],
  "blocks": [
    {
      "type": "subcategory",
      "name": "Sous-catégorie",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Solitaire" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    },
    {
      "type": "editorial",
      "name": "Bloc éditorial (entre les produits)",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Le saviez-vous ?" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    },
    {
      "type": "universe",
      "name": "Univers à explorer (bas de page)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Fiançailles" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ]
}
{% endschema %}
