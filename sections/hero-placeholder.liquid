{%- comment -%}
  Temporary homepage hero — Phase 1 scaffold only.
  Replaced by the full editorial hero section in Phase 2.
{%- endcomment -%}
<section class="gm-theme-dark" style="min-height: 92vh; display:flex; align-items:flex-end; padding-bottom: var(--space-8);">
  <div class="gm-container" data-gm-reveal="fade">
    <span class="gm-eyebrow">{{ section.settings.eyebrow | default: 'Gold Mines — By Orpaz' }}</span>
    <h1 class="gm-h1" style="color:var(--gm-white); max-width: 20ch;">{{ section.settings.heading | default: "L'or a trouvé sa maison." }}</h1>
    <p class="gm-lead" style="color:rgba(255,255,255,0.75); max-width: 46ch; margin-top: var(--space-3);">{{ section.settings.subheading | default: 'Créations, sur-mesure et haute joaillerie contemporaine.' }}</p>
    <div style="display:flex; gap: var(--space-3); margin-top: var(--space-5); flex-wrap: wrap;">
      <a href="{{ section.settings.primary_link | default: '/collections/all' }}" class="gm-btn gm-btn--primary">Découvrir les créations</a>
      <a href="{{ routes.root_url }}pages/rendez-vous" class="gm-btn gm-btn--outline" style="color:var(--gm-white);">Prendre rendez-vous</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero (provisoire)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre" },
    { "type": "url", "id": "primary_link", "label": "Lien principal" }
  ],
  "presets": [{ "name": "Hero (provisoire)" }]
}
{% endschema %}
