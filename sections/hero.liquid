{{ 'homepage.css' | asset_url | stylesheet_tag }}

<section class="gm-hero">
  <div class="gm-hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1920x' }}
    {%- elsif section.settings.image -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.heading }}
    {%- endif -%}
  </div>

  <div class="gm-container gm-hero__content" data-gm-reveal="fade">
    {%- if section.settings.eyebrow != blank -%}<span class="gm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="gm-h1">{{ section.settings.heading | default: "L'or a trouvé sa maison." }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="gm-lead" style="color:rgba(255,255,255,0.8); margin-top: var(--space-3);">{{ section.settings.subheading }}</p>{%- endif -%}
    <div class="gm-hero__actions">
      {%- if section.settings.primary_label != blank -%}
        <a href="{{ section.settings.primary_link }}" class="gm-btn gm-btn--primary">{{ section.settings.primary_label }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_link }}" class="gm-btn gm-btn--outline" style="color:var(--gm-white);">{{ section.settings.secondary_label }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="gm-hero__scroll-cue" aria-hidden="true"><span></span>Scroll</div>
</section>

{% schema %}
{
  "name": "Hero plein écran",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond" },
    { "type": "video", "id": "video", "label": "Vidéo de fond (prioritaire sur l'image)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gold Mines — By Orpaz" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "L'or a trouvé sa maison." },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre" },
    { "type": "text", "id": "primary_label", "label": "Bouton principal — libellé", "default": "Découvrir les créations" },
    { "type": "url", "id": "primary_link", "label": "Bouton principal — lien" },
    { "type": "text", "id": "secondary_label", "label": "Bouton secondaire — libellé", "default": "Prendre rendez-vous" },
    { "type": "url", "id": "secondary_link", "label": "Bouton secondaire — lien" }
  ],
  "presets": [{ "name": "Hero plein écran" }]
}
{% endschema %}
