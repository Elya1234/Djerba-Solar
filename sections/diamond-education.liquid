{{ 'pages.css' | asset_url | stylesheet_tag }}

<section class="gm-section">
  <div class="gm-container">
    <div style="max-width:60rem; margin-bottom:var(--space-7);" data-gm-reveal="fade">
      {%- if section.settings.eyebrow != blank -%}<span class="gm-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="gm-h2">{{ section.settings.heading | default: 'Comprendre un diamant' }}</h2>
      {%- if section.settings.text != blank -%}<p class="gm-lead" style="margin-top:var(--space-3);">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="gm-education-grid" data-gm-reveal="fade">
      {%- for block in section.blocks -%}
        <div class="gm-education-card" {{ block.shopify_attributes }}>
          <div class="gm-education-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <div style="text-align:center; margin-top:var(--space-6);">
        <a href="{{ section.settings.link }}" class="gm-btn gm-btn--outline">{{ section.settings.link_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Éducation diamants (4C)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Le guide du diamant" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Comprendre un diamant" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "text", "id": "link_label", "label": "Libellé du lien" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "blocks": [
    {
      "type": "criterion",
      "name": "Critère",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Carat" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Éducation diamants (4C)",
      "blocks": [
        { "type": "criterion", "settings": { "title": "Carat", "text": "Le carat mesure le poids du diamant (1 carat = 0,2 gramme). À qualité égale, le prix augmente fortement avec le carat." } },
        { "type": "criterion", "settings": { "title": "Taille (Cut)", "text": "La taille détermine la façon dont le diamant capte et réfléchit la lumière." } },
        { "type": "criterion", "settings": { "title": "Couleur", "text": "La couleur d'un diamant blanc est notée de D (incolore) à Z (teinté)." } },
        { "type": "criterion", "settings": { "title": "Pureté", "text": "La pureté évalue les inclusions internes et externes du diamant." } }
      ]
    }
  ]
}
{% endschema %}
