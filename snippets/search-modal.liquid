{{ 'search.css' | asset_url | stylesheet_tag }}

<div class="gm-search-modal" data-gm-search-modal role="dialog" aria-modal="true" aria-label="Recherche">
  <div class="gm-search-modal__inner">
    <form action="{{ routes.search_url }}" method="get" role="search" class="gm-search-modal__form" data-gm-search-form>
      {% render 'icon', name: 'search', size: 22 %}
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        class="gm-search-modal__input"
        autocomplete="off"
        data-gm-search-input
        aria-label="{{ 'general.search.placeholder' | t }}"
      >
      <button type="button" class="gm-search-modal__close" data-gm-search-close aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </form>

    <div class="gm-search-modal__results" data-gm-search-results hidden></div>
    <p class="gm-search-modal__hint" data-gm-search-hint>Essayez « bague diamant », « or jaune », « émeraude »…</p>
  </div>
</div>
