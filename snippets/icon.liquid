{%- comment -%}
  Renders a themed line icon.
  Usage: {% render 'icon', name: 'search' %}
  Supported names: search, account, heart, bag, menu, close, chevron-down,
  chevron-right, plus, whatsapp, phone, pin, instagram, facebook, pinterest.
{%- endcomment -%}
{%- liquid
  assign size = size | default: 20
-%}
<svg class="gm-icon gm-icon--{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="10.5" cy="10.5" r="6.5"></circle><line x1="20" y1="20" x2="15.3" y2="15.3"></line>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-3.9 3.6-7 8-7s8 3.1 8 7"></path>
    {%- when 'heart' -%}
      <path d="M12 20.5s-7.5-4.6-9.7-9.2C.7 8 2 4.5 5.4 3.7 8 3.1 10.4 4.4 12 6.6c1.6-2.2 4-3.5 6.6-2.9C22 4.5 23.3 8 21.7 11.3 19.5 15.9 12 20.5 12 20.5z"></path>
    {%- when 'bag' -%}
      <path d="M6 8h12l-1 12.5a1 1 0 0 1-1 .9H8a1 1 0 0 1-1-.9L6 8z"></path><path d="M9 8V6.5a3 3 0 0 1 6 0V8"></path>
    {%- when 'menu' -%}
      <line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line>
    {%- when 'close' -%}
      <line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line>
    {%- when 'chevron-down' -%}
      <polyline points="5 8 12 15 19 8"></polyline>
    {%- when 'chevron-right' -%}
      <polyline points="9 5 16 12 9 19"></polyline>
    {%- when 'plus' -%}
      <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
    {%- when 'whatsapp' -%}
      <path d="M4 20l1.3-4A8 8 0 1 1 8.5 19L4 20z"></path><path d="M8.5 9.5c0 3.5 3 6.5 6.5 6.5"></path>
    {%- when 'phone' -%}
      <path d="M6 3h3l1.5 4.5-2 1.5a11 11 0 0 0 6.5 6.5l1.5-2L21 15v3a2 2 0 0 1-2 2C10.6 20 4 13.4 4 5a2 2 0 0 1 2-2z"></path>
    {%- when 'pin' -%}
      <path d="M12 21s7-6.3 7-11.5A7 7 0 0 0 5 9.5C5 14.7 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.3"></circle>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17" cy="7" r="0.6" fill="currentColor"></circle>
    {%- when 'facebook' -%}
      <path d="M14 21v-8h2.5l.5-3H14V8c0-.9.3-1.5 1.6-1.5H17V4h-2.4C12 4 11 5.5 11 8v2H9v3h2v8z" fill="currentColor" stroke="none"></path>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9"></circle><path d="M9.5 18c1-3 2-6.3 2-6.3M12 8.5c2.5 0 4 1.4 4 3.4 0 2.4-1.3 4.3-3.3 4.3-1 0-1.7-.5-1.9-1.1"></path>
  {%- endcase -%}
</svg>
