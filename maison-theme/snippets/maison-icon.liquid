{%- comment -%}
  Icônes filaires de la Maison — trait 1px, grille 24.
  Usage : {% render 'maison-icon', icon: 'search' %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'search' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="M15.8 15.8 21 21"/></svg>
  {%- when 'heart' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.2S3.8 15 3.8 9.4A4.4 4.4 0 0 1 12 7a4.4 4.4 0 0 1 8.2 2.4c0 5.6-8.2 10.8-8.2 10.8Z"/></svg>
  {%- when 'account' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8.2" r="3.9"/><path d="M4.6 20.2c0-3.6 3.3-6.1 7.4-6.1s7.4 2.5 7.4 6.1"/></svg>
  {%- when 'bag' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5.2 7.4h13.6l1 13.2H4.2Z"/><path d="M8.8 9.6V6.9a3.2 3.2 0 0 1 6.4 0v2.7"/></svg>
  {%- when 'globe' -%}
    <svg class="icon icon--s" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.4"/><path d="M3.6 12h16.8M12 3.6c2.2 2.3 3.3 5.2 3.3 8.4s-1.1 6.1-3.3 8.4c-2.2-2.3-3.3-5.2-3.3-8.4S9.8 5.9 12 3.6Z"/></svg>
  {%- when 'burger' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 8.5h17M3.5 15.5h17"/></svg>
  {%- when 'close' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>

  {%- comment -%} ---- Formes de pierre — trait fin, style « taille de diamant » ---- {%- endcomment -%}
  {%- when 'shape-rond' or 'shape-round' -%}
    <svg class="icon icon--shape" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.4"/></svg>
  {%- when 'shape-ovale' or 'shape-oval' -%}
    <svg class="icon icon--shape" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><ellipse cx="12" cy="12" rx="6.4" ry="9"/><ellipse cx="12" cy="12" rx="2.6" ry="5"/></svg>
  {%- when 'shape-emeraude' or 'shape-emerald' -%}
    <svg class="icon icon--shape" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 4.5h10.8l3 4.2v6.6l-3 4.2H6.6l-3-4.2V8.7Z"/><path d="M9.4 8h5.2l2 4-2 4H9.4l-2-4Z"/></svg>
  {%- when 'shape-poire' or 'shape-pear' -%}
    <svg class="icon icon--shape" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.4c2.4 3 5.2 6 5.2 9.8a5.2 5.2 0 0 1-10.4 0c0-3.8 2.8-6.8 5.2-9.8Z"/><path d="M12 8.6c1 1.5 2.3 3.1 2.3 4.9a2.3 2.3 0 1 1-4.6 0c0-1.8 1.3-3.4 2.3-4.9Z"/></svg>
  {%- when 'shape-coussin' or 'shape-cushion' -%}
    <svg class="icon icon--shape" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 8.6C5 6 6.5 4.5 9.4 4.5h5.2C17.5 4.5 19 6 19 8.6v6.8c0 2.6-1.5 4.1-4.4 4.1H9.4C6.5 19.5 5 18 5 15.4Z"/><path d="M9 9.3h6l2.2 2.7-2.2 2.7H9l-2.2-2.7Z"/></svg>
  {%- when 'shape-marquise' -%}
    <svg class="icon icon--shape" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.6c3.6 2.6 7.2 5.2 7.2 8.4S15.6 17.8 12 20.4C8.4 17.8 4.8 15.2 4.8 12S8.4 6.2 12 3.6Z"/><path d="M12 8.2c1.9 1.4 3.8 2.7 3.8 3.8s-1.9 2.4-3.8 3.8c-1.9-1.4-3.8-2.7-3.8-3.8s1.9-2.4 3.8-3.8Z"/></svg>
  {%- when 'shape-radiant' -%}
    <svg class="icon icon--shape" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7.2 4.5h9.6l3.2 3.2v8.6l-3.2 3.2H7.2L4 16.3V7.7Z"/><path d="M9.6 8h4.8l2.4 2.4-2.4 2.4H9.6L7.2 10.4Z"/></svg>
  {%- when 'shape-princesse' or 'shape-princess' -%}
    <svg class="icon icon--shape" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4.8" y="4.8" width="14.4" height="14.4"/><path d="M4.8 4.8 11 11m2 0 6.2-6.2M4.8 19.2 11 13m2 0 6.2 6.2"/></svg>
  {%- when 'shape-coeur' or 'shape-cœur' or 'shape-heart' -%}
    <svg class="icon icon--shape" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19.6S4.4 14.7 4.4 9.5A3.9 3.9 0 0 1 12 7.9a3.9 3.9 0 0 1 7.6 1.6c0 5.2-7.6 10.1-7.6 10.1Z"/></svg>
{%- endcase -%}
