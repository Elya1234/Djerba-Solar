{%- comment -%} Galerie plein écran : tap sur mobile, clic sur ordinateur. {%- endcomment -%}
<div class="pzoom" id="MaisonZoom" data-modal data-zoom role="dialog" aria-modal="true" aria-label="{{ 'products.gallery' | t: default: 'Galerie' }}" aria-hidden="true">
  <div class="pzoom__bar">
    <p class="t-label" data-zoom-counter>1 / 1</p>
    <div class="pzoom__nav">
      <button class="hdr__util" type="button" data-zoom-prev aria-label="{{ 'products.previous_media' | t: default: 'Média précédent' }}">
        <span class="mmenu__chev" style="transform: rotate(-135deg)" aria-hidden="true"></span>
      </button>
      <button class="hdr__util" type="button" data-zoom-next aria-label="{{ 'products.next_media' | t: default: 'Média suivant' }}">
        <span class="mmenu__chev" aria-hidden="true"></span>
      </button>
      <button class="hdr__util" type="button" data-zoom-close data-modal-close>
        {% render 'maison-icon', icon: 'close' %}
        <span class="visually-hidden">{{ 'general.close' | t: default: 'Fermer' }}</span>
      </button>
    </div>
  </div>
  <div class="pzoom__stage">
    <img data-zoom-image src="" alt="">
  </div>
</div>
