<section class="section stones" data-stones>
  <div class="page">
    <div class="stones__grid">
      <div class="stones__stage" data-reveal="mask">
        {%- for block in section.blocks -%}
          <div class="stones__img{% if forloop.first %} is-active{% endif %}" data-stone-image="{{ block.settings.title | handleize }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 60vw, 100vw', widths: '700,1100,1600', alt: block.settings.title }}
            {%- else -%}
              {% render 'maison-placeholder', label: block.settings.title, variant: 'dark' %}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="stones__panel">
        {%- if section.settings.eyebrow != blank -%}
          <p class="t-label eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="t-h1 line-mask" style="margin-top: var(--s-4)" data-reveal="mask"><span>{{ section.settings.title }}</span></h2>
        {%- endif -%}

        <div class="stones__text" style="margin-top: var(--s-5)">
          {%- for block in section.blocks -%}
            <div class="stones__copy{% if forloop.first %} is-active{% endif %}" data-stone-copy="{{ block.settings.title | handleize }}" {{ block.shopify_attributes }}>
              <p class="t-h3 stones__title">{{ block.settings.heading | default: block.settings.title }}</p>
              <p class="t-body-s measure t-muted">{{ block.settings.text }}</p>
              {%- if block.settings.link != blank -%}
                <a class="cta" href="{{ block.settings.link }}" style="margin-top: var(--s-5)">
                  {{ block.settings.link_label | default: 'Découvrir' }}<span class="cta__arrow" aria-hidden="true"></span>
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="stones__list" role="tablist" aria-label="{{ section.settings.title | escape }}">
          {%- for block in section.blocks -%}
            <button
              class="stones__btn t-nav"
              type="button"
              role="tab"
              data-stone="{{ block.settings.title | handleize }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              <span>{{ block.settings.title }}</span>
              {%- if block.settings.note != blank -%}<span class="stones__btn-carat">{{ block.settings.note }}</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Diamants & pierres",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Les pierres" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Choisies une à une" }
  ],
  "blocks": [
    {
      "type": "pierre",
      "name": "Pierre",
      "settings": [
        { "type": "text", "id": "title", "label": "Nom", "default": "Diamant" },
        { "type": "text", "id": "note", "label": "Mention courte" },
        { "type": "image_picker", "id": "image", "label": "Image macro" },
        { "type": "text", "id": "heading", "label": "Titre du texte" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{
    "name": "Diamants & pierres",
    "blocks": [
      { "type": "pierre", "settings": { "title": "Diamant" } },
      { "type": "pierre", "settings": { "title": "Émeraude" } },
      { "type": "pierre", "settings": { "title": "Saphir" } },
      { "type": "pierre", "settings": { "title": "Rubis" } }
    ]
  }]
}
{% endschema %}
