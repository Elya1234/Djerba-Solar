{%- comment -%} Étapes numérotées : savoir-faire, service, méthode de mesure. {%- endcomment -%}
<section class="section esteps">
  <div class="page">
    {%- if section.settings.title != blank -%}
      <div style="margin-bottom: clamp(28px, 3vw, 56px)">
        {%- if section.settings.eyebrow != blank -%}
          <p class="t-label eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="t-h1 line-mask" style="margin-top: var(--s-4)" data-reveal="mask"><span>{{ section.settings.title }}</span></h2>
        {%- if section.settings.text != blank -%}
          <p class="t-body measure t-muted" style="margin-top: var(--s-5)" data-reveal>{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="esteps__grid">
      {%- for block in section.blocks -%}
        <article class="estep" {{ block.shopify_attributes }} data-reveal style="--i: {{ forloop.index0 }}">
          {%- if block.settings.image != blank -%}
            <div class="frame estep__frame">
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 1200px) 22vw, 45vw', widths: '300,500,700', alt: block.settings.title }}
            </div>
          {%- endif -%}
          {%- if section.settings.numbered -%}
            <p class="t-label estep__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
          {%- endif -%}
          <h3 class="t-h3">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="estep__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <a class="cta" href="{{ block.settings.link }}">
              {{ block.settings.link_label | default: 'Découvrir' }}<span class="cta__arrow" aria-hidden="true"></span>
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Éditorial — Étapes",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "title", "label": "Titre" },
    { "type": "textarea", "id": "text", "label": "Introduction" },
    { "type": "checkbox", "id": "numbered", "label": "Numéroter les étapes", "default": true }
  ],
  "blocks": [
    {
      "type": "etape",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Éditorial — Étapes" }]
}
{% endschema %}
