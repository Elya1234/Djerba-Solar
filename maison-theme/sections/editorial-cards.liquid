{%- comment -%}
  Cartes d'accès. Sert aux univers (Diamants, Mariage), aux services et aux
  formes de diamant. Chaque carte pointe vers une destination réelle ; sans
  lien, elle n'est pas affichée.
{%- endcomment -%}
<section class="section ecards{% if section.settings.background == 'surface' %} ecards--surface{% endif %}{% if section.settings.ratio == 'landscape' %} ecards--wide{% endif %}{% if section.settings.style == 'shape' %} ecards--compact{% endif %}">
  <div class="page">
    {%- if section.settings.title != blank -%}
      <div class="sel__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="t-label eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="t-h1 line-mask" style="margin-top: var(--s-4)" data-reveal="mask"><span>{{ section.settings.title }}</span></h2>
        </div>
        {%- if section.settings.cta_link != blank and section.settings.cta_label != blank -%}
          <a class="cta" href="{{ section.settings.cta_link }}" data-reveal style="--i: 1">
            {{ section.settings.cta_label }}<span class="cta__arrow" aria-hidden="true"></span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ecards__grid" style="--per-row: {{ section.settings.per_row }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign destination = block.settings.link
          assign image = block.settings.image
          if destination == blank and block.settings.collection != blank
            assign destination = block.settings.collection.url
          endif
          if image == blank and block.settings.collection.image
            assign image = block.settings.collection.image
          endif
          assign heading = block.settings.title | default: block.settings.collection.title
        -%}
        {%- if destination != blank -%}
          {%- if section.settings.style == 'shape' -%}
            <a class="eshape" href="{{ destination }}" {{ block.shopify_attributes }} data-reveal style="--i: {{ forloop.index0 }}">
              <span class="eshape__figure">
                <span class="eshape__glyph eshape__glyph--{{ heading | handleize }}" aria-hidden="true"></span>
              </span>
              <span class="eshape__name">{{ heading }}</span>
              {%- if block.settings.text != blank -%}<span class="eshape__text">{{ block.settings.text }}</span>{%- endif -%}
            </a>
          {%- else -%}
            <a class="ecard" href="{{ destination }}" {{ block.shopify_attributes }} data-reveal style="--i: {{ forloop.index0 }}">
              <div class="frame frame--zoom ecard__frame">
                {%- if image != blank -%}
                  {{ image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 30vw, 45vw', widths: '400,700,1000,1200', alt: heading }}
                {%- else -%}
                  {% render 'maison-placeholder', label: heading %}
                {%- endif -%}
              </div>
              <div class="ecard__label">
                <span class="t-h3 ecard__name">{{ heading }}</span>
                <span class="cta">{{ block.settings.cta_label | default: 'Découvrir' }}<span class="cta__arrow" aria-hidden="true"></span></span>
              </div>
              {%- if block.settings.text != blank -%}<p class="ecard__text">{{ block.settings.text }}</p>{%- endif -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Cartes d'accès",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "title", "label": "Titre" },
    { "type": "text", "id": "cta_label", "label": "Libellé du lien d'en-tête" },
    { "type": "url", "id": "cta_link", "label": "Lien d'en-tête" },
    { "type": "range", "id": "per_row", "label": "Cartes par ligne", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "select", "id": "style", "label": "Présentation", "default": "image",
      "options": [ { "value": "image", "label": "Photographie" }, { "value": "shape", "label": "Silhouette de taille" } ] },
    { "type": "select", "id": "ratio", "label": "Format", "default": "portrait",
      "options": [ { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Paysage" } ] },
    { "type": "select", "id": "background", "label": "Fond", "default": "paper",
      "options": [ { "value": "paper", "label": "Papier" }, { "value": "surface", "label": "Blanc" } ] }
  ],
  "blocks": [
    {
      "type": "carte",
      "name": "Carte",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Fournit lien, titre et image si les champs restent vides." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "cta_label", "label": "Libellé du lien", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien", "info": "Sans lien ni collection, la carte n'est pas affichée." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Cartes d'accès" }]
}
{% endschema %}
