<section class="section sig sig--{{ section.settings.layout }}">
  <div class="page">
    <div class="sig__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="t-label eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="t-display sig__title line-mask" data-reveal="mask"><span>{{ section.settings.title }}</span></h2>
      {%- endif -%}
    </div>

    <div class="sig__media">
      <div class="frame sig__frame" data-reveal="mask" {% if section.settings.parallax %}data-parallax="20"{% endif %}>
        {%- if section.settings.image != blank -%}
          {%- if section.settings.image_mobile != blank -%}
            <picture>
              <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
              {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800,1200,2000', alt: section.settings.image_alt }}
            </picture>
          {%- else -%}
            {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800,1200,2000', alt: section.settings.image_alt }}
          {%- endif -%}
        {%- else -%}
          {% render 'maison-placeholder', label: 'Création signature' %}
        {%- endif -%}
      </div>

      {%- if section.settings.layout == 'split' -%}
        <div class="sig__aside">
          {%- if section.settings.text != blank -%}
            <p class="t-body measure t-muted" data-reveal style="--i: 1">{{ section.settings.text }}</p>
          {%- endif -%}
          {%- if section.settings.cta_link != blank -%}
            <a class="cta" href="{{ section.settings.cta_link }}" data-reveal style="--i: 2">
              {{ section.settings.cta_label | default: 'Découvrir' }}<span class="cta__arrow" aria-hidden="true"></span>
            </a>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="sig__caption">
          {%- if section.settings.text != blank -%}
            <p class="t-body-s measure t-muted" data-reveal style="--i: 1">{{ section.settings.text }}</p>
          {%- endif -%}
          {%- if section.settings.cta_link != blank -%}
            <a class="cta" href="{{ section.settings.cta_link }}" data-reveal style="--i: 2">
              {{ section.settings.cta_label | default: 'Découvrir' }}<span class="cta__arrow" aria-hidden="true"></span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Création signature",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "layout", "label": "Composition", "default": "full",
      "options": [
        { "value": "full", "label": "Image large" },
        { "value": "split", "label": "Image + texte" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "La Maison présente" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Une création emblématique" },
    { "type": "textarea", "id": "text", "label": "Texte" },
    { "type": "image_picker", "id": "image", "label": "Image desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image mobile" },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif" },
    { "type": "text", "id": "cta_label", "label": "Libellé du lien", "default": "Découvrir" },
    { "type": "url", "id": "cta_link", "label": "Lien" },
    { "type": "checkbox", "id": "parallax", "label": "Parallaxe très légère", "default": true }
  ],
  "presets": [{ "name": "Création signature" }]
}
{% endschema %}
