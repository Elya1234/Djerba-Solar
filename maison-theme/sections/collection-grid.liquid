{%- comment -%}
  MAISON — Grille de collection
  Filtres et tri natifs Shopify (Search & Discovery). Le formulaire est un
  vrai formulaire GET : il fonctionne sans JavaScript.
{%- endcomment -%}

{%- paginate collection.products by section.settings.per_page -%}
  {%- liquid
    assign has_active = false
    for filter in collection.filters
      if filter.active_values.size > 0
        assign has_active = true
      endif
      if filter.type == 'price_range'
        if filter.min_value.value or filter.max_value.value
          assign has_active = true
        endif
      endif
    endfor
  -%}

  <div data-filters-root>
    {%- if section.settings.show_tools -%}
      <div class="ctools">
        <div class="page ctools__inner">
          <p class="t-label ctools__count">
            {{ collection.products_count }} {% if collection.products_count == 1 %}{{ 'collection.creation' | t: default: 'création' }}{% else %}{{ 'collection.creations' | t: default: 'créations' }}{% endif %}
          </p>

          <div class="ctools__right">
            {%- if collection.filters.size > 0 -%}
              <button class="ctools__btn t-label" type="button" data-filters-toggle aria-expanded="false" aria-controls="CollectionFilters">
                {{ 'collection.filter' | t: default: 'Filtrer' }}
                <span class="ctools__btn-plus" aria-hidden="true"></span>
              </button>
            {%- endif -%}

            <div class="csort">
              <label class="visually-hidden" for="SortBy">{{ 'collection.sort' | t: default: 'Trier par' }}</label>
              <select id="SortBy" name="sort_by" form="CollectionFilterForm" data-sort>
                {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if collection.filters.size > 0 -%}
      <div class="cfilters" id="CollectionFilters" data-filters-panel aria-hidden="true">
        <div class="cfilters__bar">
          <p class="t-label">{{ 'collection.filters' | t: default: 'Filtres' }}</p>
          <button class="hdr__util" type="button" data-filters-close>
            {% render 'maison-icon', icon: 'close' %}
            <span class="visually-hidden">{{ 'collection.close_filters' | t: default: 'Fermer les filtres' }}</span>
          </button>
        </div>

        <form id="CollectionFilterForm" data-filters-form method="get" action="{{ collection.url }}">
          <div class="page">
            <div class="cfilters__inner" data-filters-inner>
              <div class="cfilters__grid">
                {%- for filter in collection.filters -%}
                  {%- liquid
                    comment
                      Une petite pastille de couleur devant le libellé pour les filtres
                      « couleur » (métal, couleur de pierre...) — jamais pour un filtre
                      sans lien avec une couleur (prix, disponibilité...).
                    endcomment
                    assign filter_label_lower = filter.label | downcase
                    assign show_dot = false
                    assign dot_words = 'métal,metal,couleur,color,pierre,gemme,stone' | split: ','
                    for word in dot_words
                      if filter_label_lower contains word
                        assign show_dot = true
                      endif
                    endfor
                    assign show_shape_icon = false
                    if filter_label_lower contains 'forme' or filter_label_lower contains 'shape'
                      assign show_shape_icon = true
                      assign show_dot = false
                    endif
                  -%}
                  <fieldset class="cfilter">
                    <legend class="t-label cfilter__title">{{ filter.label }}</legend>

                    {%- case filter.type -%}
                      {%- when 'list', 'boolean' -%}
                        <div class="cfilter__list">
                          {%- for value in filter.values -%}
                            <label class="copt{% if show_dot %} copt--dot{% endif %}">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                {% if value.active %}checked{% endif %}
                                {% if value.count == 0 and value.active == false %}disabled{% endif %}
                              >
                              <span class="copt__pill">
                                {%- if show_dot -%}
                                  <span class="copt__dot copt__dot--{{ value.label | handleize }}" aria-hidden="true"></span>
                                {%- elsif show_shape_icon -%}
                                  {% render 'maison-icon', icon: 'shape-' | append: value.label | handleize %}
                                {%- endif -%}
                                <span class="copt__label">{{ value.label }}</span>
                                {%- if value.count > 0 -%}<span class="copt__count">{{ value.count }}</span>{%- endif -%}
                              </span>
                            </label>
                          {%- endfor -%}
                        </div>

                      {%- when 'price_range' -%}
                        <div class="cprice">
                          <label class="visually-hidden" for="PriceMin">{{ 'collection.price_min' | t: default: 'Prix minimum' }}</label>
                          <input
                            id="PriceMin"
                            type="number"
                            inputmode="numeric"
                            name="{{ filter.min_value.param_name }}"
                            placeholder="{{ 0 | money_without_currency }}"
                            {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '.' }}"{% endif %}
                            min="0"
                            max="{{ filter.range_max | money_without_currency | replace: ',', '.' }}"
                          >
                          <span aria-hidden="true">—</span>
                          <label class="visually-hidden" for="PriceMax">{{ 'collection.price_max' | t: default: 'Prix maximum' }}</label>
                          <input
                            id="PriceMax"
                            type="number"
                            inputmode="numeric"
                            name="{{ filter.max_value.param_name }}"
                            placeholder="{{ filter.range_max | money_without_currency }}"
                            {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '.' }}"{% endif %}
                            min="0"
                            max="{{ filter.range_max | money_without_currency | replace: ',', '.' }}"
                          >
                        </div>
                    {%- endcase -%}
                  </fieldset>
                {%- endfor -%}
              </div>

              <div class="cfilters__foot">
                <a class="cta" href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}">
                  {{ 'collection.clear' | t: default: 'Effacer' }}
                </a>
                <button class="btn btn--solid" type="submit">{{ 'collection.apply' | t: default: 'Appliquer' }}</button>
              </div>
            </div>
          </div>
        </form>
      </div>
    {%- endif -%}

    {%- if has_active -%}
      <div class="page">
        <div class="cactive">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a class="cchip t-label" href="{{ value.url_to_remove }}">
                {{ value.label }}<span class="cchip__x" aria-hidden="true"></span>
              </a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value or filter.max_value.value -%}
                <a class="cchip t-label" href="{{ filter.url_to_remove }}">
                  {{ filter.min_value.value | default: 0 | money }} — {{ filter.max_value.value | default: filter.range_max | money }}<span class="cchip__x" aria-hidden="true"></span>
                </a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <a class="t-label link-quiet" href="{{ collection.url }}">{{ 'collection.clear_all' | t: default: 'Tout effacer' }}</a>
        </div>
      </div>
    {%- endif -%}

    <section class="cgrid">
      <div class="page">
        {%- if collection.products.size > 0 -%}
          <div class="cgrid__list" {% if section.settings.wide %}data-wide{% endif %}>
            {%- for product in collection.products -%}
              {% render 'maison-card-product', product: product, index: forloop.index0 %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="cpage t-label" aria-label="{{ 'collection.pagination' | t: default: 'Pagination' }}">
              {%- if paginate.previous -%}
                <a class="cpage__link" href="{{ paginate.previous.url }}">{{ 'collection.previous' | t: default: 'Précédent' }}</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a class="cpage__link" href="{{ part.url }}">{{ part.title }}</a>
                {%- else -%}
                  <span class="cpage__link" {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a class="cpage__link" href="{{ paginate.next.url }}">{{ 'collection.next' | t: default: 'Suivant' }}</a>
              {%- endif -%}
            </nav>
          {%- endif -%}

        {%- else -%}
          <div class="cempty">
            {%- if has_active -%}
              <h2 class="t-h2 cempty__title">{{ 'collection.no_result' | t: default: 'Aucune création ne correspond à cette sélection.' }}</h2>
              <a class="cta" href="{{ collection.url }}">
                {{ 'collection.clear_all' | t: default: 'Tout effacer' }}<span class="cta__arrow" aria-hidden="true"></span>
              </a>
            {%- else -%}
              <h2 class="t-h2 cempty__title">{{ section.settings.empty_title | default: 'Les prochaines créations arrivent bientôt.' }}</h2>
              {%- if section.settings.empty_text != blank -%}
                <p class="t-body-s t-muted measure">{{ section.settings.empty_text }}</p>
              {%- endif -%}
              {%- if section.settings.empty_link != blank -%}
                <a class="cta" href="{{ section.settings.empty_link }}">
                  {{ section.settings.empty_label | default: 'Découvrir la joaillerie' }}<span class="cta__arrow" aria-hidden="true"></span>
                </a>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </section>

    {%- comment -%}
      ---------- BARRE FILTRER / TRIER — mobile uniquement ----------
      Remplace la barre en ligne (.ctools) sur petit écran par deux boutons
      fixés en bas, comme le reste du système (menu, fiche produit). Réutilise
      les mêmes déclencheurs (data-filters-toggle) et le même <select> réel
      (#SortBy, via un <label for>) : aucune logique dupliquée.
    {%- endcomment -%}
    {%- liquid
      assign show_mobile_bar = false
      if section.settings.show_tools and collection.products.size > 0
        if collection.filters.size > 0 or collection.sort_options.size > 1
          assign show_mobile_bar = true
        endif
      endif
    -%}
    {%- if show_mobile_bar -%}
      <div class="cbar" data-collection-bar>
        {%- if collection.filters.size > 0 -%}
          <button class="cbar__btn" type="button" data-filters-toggle aria-expanded="false" aria-controls="CollectionFilters">
            {% render 'maison-icon', icon: 'filters' %}
            {{ 'collection.filter' | t: default: 'Filtrer' }}
          </button>
          <span class="cbar__sep" aria-hidden="true"></span>
        {%- endif -%}
        <label class="cbar__btn" for="SortBy">
          {% render 'maison-icon', icon: 'sort' %}
          {{ 'collection.sort' | t: default: 'Trier' }}
        </label>
      </div>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Grille de collection",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_tools", "label": "Afficher la barre filtres / tri", "default": true },
    { "type": "range", "id": "per_page", "label": "Créations par page", "min": 12, "max": 48, "step": 6, "default": 24 },
    { "type": "checkbox", "id": "wide", "label": "Quatre créations par ligne sur très grand écran", "default": true },
    { "type": "header", "content": "Collection encore vide" },
    { "type": "text", "id": "empty_title", "label": "Titre", "default": "Les prochaines créations arrivent bientôt." },
    { "type": "textarea", "id": "empty_text", "label": "Texte" },
    { "type": "text", "id": "empty_label", "label": "Libellé du lien", "default": "Découvrir la joaillerie" },
    { "type": "url", "id": "empty_link", "label": "Lien" }
  ],
  "presets": [{ "name": "Grille de collection" }]
}
{% endschema %}
