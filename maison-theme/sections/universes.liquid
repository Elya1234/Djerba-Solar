<section class="section univ">
  <div class="page">
    <div class="univ__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="t-label eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="t-h1 line-mask" style="margin-top: var(--s-4)" data-reveal="mask"><span>{{ section.settings.title }}</span></h2>
        {%- endif -%}
      </div>
      {%- if section.settings.cta_link != blank -%}
        <a class="cta" href="{{ section.settings.cta_link }}" data-reveal style="--i: 1">
          {{ section.settings.cta_label | default: 'Toutes les créations' }}<span class="cta__arrow" aria-hidden="true"></span>
        </a>
      {%- endif -%}
    </div>

    <div class="univ__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign destination = block.settings.link
          assign image = block.settings.image
          if destination == blank and block.settings.collection != blank
            assign destination = block.settings.collection.url
          endif
          if image == blank and block.settings.collection.image
            assign image = block.settings.collection.image
          endif
        -%}
        {%- if destination == blank -%}{%- continue -%}{%- endif -%}
        <a class="univ__item" href="{{ destination }}" {{ block.shopify_attributes }} data-reveal style="--i: {{ forloop.index0 }}">
          <div class="frame frame--zoom univ__frame">
            {%- if image != blank -%}
              {%- if block.settings.image_mobile != blank -%}
                <picture>
                  <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 1000 }}">
                  {{ image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 45vw, 100vw', widths: '600,900,1400', alt: block.settings.title }}
                </picture>
              {%- else -%}
                {{ image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 45vw, 100vw', widths: '600,900,1400', alt: block.settings.title }}
              {%- endif -%}
            {%- else -%}
              {% render 'maison-placeholder', label: block.settings.title %}
            {%- endif -%}
          </div>
          <div class="univ__label">
            <span class="t-h3 univ__name">{{ block.settings.title }}</span>
            <span class="cta">{{ block.settings.cta_label | default: 'Découvrir' }}<span class="cta__arrow" aria-hidden="true"></span></span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Univers de la Maison",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Les univers" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Cinq façons de porter la lumière" },
    { "type": "text", "id": "cta_label", "label": "Libellé du lien" },
    { "type": "url", "id": "cta_link", "label": "Lien" }
  ],
  "blocks": [
    {
      "type": "univers",
      "name": "Univers",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Bagues" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Fournit le lien et l'image si les champs ci-dessous restent vides." },
        { "type": "image_picker", "id": "image", "label": "Image desktop" },
        { "type": "image_picker", "id": "image_mobile", "label": "Image mobile" },
        { "type": "text", "id": "cta_label", "label": "Libellé du lien", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{
    "name": "Univers de la Maison",
    "blocks": [
      { "type": "univers", "settings": { "title": "Bagues" } },
      { "type": "univers", "settings": { "title": "Bracelets" } },
      { "type": "univers", "settings": { "title": "Colliers" } },
      { "type": "univers", "settings": { "title": "Mariage" } },
      { "type": "univers", "settings": { "title": "Pierres" } }
    ]
  }]
}
{% endschema %}
