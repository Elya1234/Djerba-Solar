<section class="section section--tight serv">
  <div class="page">
    <div class="serv__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="t-label eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="t-h2 line-mask" style="margin-top: var(--s-4)" data-reveal="mask"><span>{{ section.settings.title }}</span></h2>
      {%- endif -%}
    </div>

    <div class="serv__list">
      {%- for block in section.blocks -%}
        <div class="serv__row" {{ block.shopify_attributes }} data-reveal style="--i: {{ forloop.index0 }}">
          <p class="serv__name">{{ block.settings.title }}</p>
          <p class="serv__text">{{ block.settings.text }}</p>
          {%- if block.settings.link != blank -%}
            <a class="cta serv__cta" href="{{ block.settings.link }}">
              {{ block.settings.link_label | default: 'En savoir plus' }}<span class="cta__arrow" aria-hidden="true"></span>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Services",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Services" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ce que la Maison vous propose" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Conseil joaillier" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "En savoir plus" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "Services",
    "blocks": [
      { "type": "service", "settings": { "title": "Conseil joaillier" } },
      { "type": "service", "settings": { "title": "Rendez-vous" } },
      { "type": "service", "settings": { "title": "Écrin et gravure" } },
      { "type": "service", "settings": { "title": "Livraison" } },
      { "type": "service", "settings": { "title": "Entretien" } }
    ]
  }]
}
{% endschema %}
