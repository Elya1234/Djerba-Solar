{%- comment -%}
  MAISON — Header
  Contient : barre utilitaire, logo centré, navbar, mega-menu, menu mobile.
  Tout le contenu provient des menus Shopify et des blocs de section.
{%- endcomment -%}

{%- comment -%} maison-header.css est chargé une seule fois, depuis layout/theme.liquid {%- endcomment -%}
<script src="{{ 'maison-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign menu = linklists[section.settings.menu]
  assign transparent = false
  assign t_list = section.settings.transparent_templates | replace: ' ', '' | split: ','
  for t in t_list
    if t == template.name or t == template
      assign transparent = true
    endif
  endfor
-%}

<header
  class="hdr{% if transparent and section.settings.transparent_light %} is-inverted{% endif %}"
  data-header
  {% if transparent %}data-transparent{% endif %}
  role="banner"
>
  <div class="hdr__surface" aria-hidden="true"></div>

  <div class="hdr__bar">
    <div class="hdr__zone hdr__zone--left">
      <button class="hdr__util hdr__burger" type="button" data-mmenu-open aria-expanded="false" aria-controls="MaisonMobileMenu">
        {% render 'maison-icon', icon: 'burger' %}
        <span class="visually-hidden">{{ 'header.open_menu' | t: default: 'Ouvrir le menu' }}</span>
      </button>

      {%- if section.settings.show_localization -%}
        {%- if localization.available_countries.size > 1 -%}
          {%- form 'localization', class: 'hdr__locale' -%}
            <label class="visually-hidden" for="MaisonCountry">{{ 'header.country' | t: default: 'Pays / région' }}</label>
            {% render 'maison-icon', icon: 'globe' %}
            <select class="hdr__locale-select t-label" id="MaisonCountry" name="country_code">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                  {{ country.name }}
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- else -%}
          <span class="hdr__locale t-label t-muted">
            {% render 'maison-icon', icon: 'globe' %}
            {{ localization.country.name | default: shop.address.country }}
          </span>
        {%- endif -%}
      {%- endif -%}
    </div>

    <a class="hdr__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — {{ 'header.home' | t: default: 'Accueil' }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 480 | image_tag: loading: 'eager', alt: shop.name }}
      {%- else -%}
        <span class="hdr__logo-mark">{{ section.settings.logo_text | default: shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="hdr__zone hdr__zone--right">
      <a class="hdr__util hdr__util--search t-label" href="{{ routes.search_url }}" data-search-open>
        {% render 'maison-icon', icon: 'search' %}
        <span class="visually-hidden">{{ 'header.search' | t: default: 'Rechercher' }}</span>
      </a>

      {%- if section.settings.wishlist_link != blank -%}
        <a class="hdr__util" href="{{ section.settings.wishlist_link }}">
          {% render 'maison-icon', icon: 'heart' %}
          <span class="visually-hidden">{{ 'header.wishlist' | t: default: 'Favoris' }}</span>
          <span class="hdr__count" data-fav-count aria-hidden="true" hidden>0</span>
        </a>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <a class="hdr__util hdr__util--account" href="{{ routes.account_url }}">
          {% render 'maison-icon', icon: 'account' %}
          <span class="visually-hidden">{{ 'header.account' | t: default: 'Compte' }}</span>
        </a>
      {%- endif -%}

      <a class="hdr__util" href="{{ routes.cart_url }}" data-cart-open>
        {% render 'maison-icon', icon: 'bag' %}
        <span class="visually-hidden">{{ 'header.cart' | t: default: 'Panier' }}</span>
        <span class="hdr__count" data-header-cart-count aria-hidden="true" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- if menu != blank and menu.links.size > 0 -%}
    <nav class="hdr__nav" data-nav aria-label="{{ 'header.main_nav' | t: default: 'Navigation principale' }}">
      <ul class="nav__list">
        {%- for link in menu.links -%}
          {%- liquid
            assign has_panel = false
            for block in section.blocks
              assign handle = block.settings.parent_handle | strip | downcase
              if handle == link.handle
                assign has_panel = true
              endif
            endfor
          -%}
          <li class="nav__item">
            {%- if has_panel -%}
              <button
                class="nav__link t-nav"
                type="button"
                data-mega-trigger="{{ link.handle }}"
                aria-expanded="false"
                aria-controls="MaisonMega"
              >{{ link.title }}</button>
            {%- else -%}
              <a class="nav__link t-nav" href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="mega" id="MaisonMega" data-mega>
      <div class="mega__stage" data-mega-stage>
        {%- for block in section.blocks -%}
          {%- assign handle = block.settings.parent_handle | strip | downcase -%}
          <div class="mega__panel" data-panel="{{ handle }}" aria-hidden="true" {{ block.shopify_attributes }}>
            <div class="mega__inner">
              <div class="mega__cols">
                {%- assign col_index = 0 -%}
                {%- for i in (1..4) -%}
                  {%- liquid
                    case i
                      when 1
                        assign list = linklists[block.settings.menu_1]
                        assign title = block.settings.title_1
                      when 2
                        assign list = linklists[block.settings.menu_2]
                        assign title = block.settings.title_2
                      when 3
                        assign list = linklists[block.settings.menu_3]
                        assign title = block.settings.title_3
                      when 4
                        assign list = linklists[block.settings.menu_4]
                        assign title = block.settings.title_4
                    endcase
                  -%}
                  {%- if list != blank and list.links.size > 0 -%}
                    <div class="mega__col" style="--i: {{ col_index }}">
                      <p class="mega__title t-label">{{ title | default: list.title }}</p>
                      <ul class="mega__links">
                        {%- for child in list.links -%}
                          <li><a class="mega__link link-rule" href="{{ child.url }}">{{ child.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    </div>
                    {%- assign col_index = col_index | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if block.settings.image != blank or block.settings.image_2 != blank -%}
                <div class="mega__media">
                  <div class="mega__media-grid{% if block.settings.image != blank and block.settings.image_2 != blank %} has-two{% endif %}">
                    {%- if block.settings.image != blank -%}
                      {%- if block.settings.image_link != blank -%}
                        <a class="mega__frame" href="{{ block.settings.image_link }}" tabindex="-1" aria-hidden="true">
                          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, 100vw', widths: '400,600,900' }}
                        </a>
                      {%- else -%}
                        <div class="mega__frame">
                          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, 100vw', widths: '400,600,900' }}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                    {%- if block.settings.image_2 != blank -%}
                      <div class="mega__frame mega__frame--small">
                        {{ block.settings.image_2 | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 14vw, 50vw', widths: '300,600' }}
                      </div>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.media_title != blank or block.settings.media_link != blank -%}
                    <div class="mega__caption">
                      {%- if block.settings.media_title != blank -%}
                        <p class="t-h3">{{ block.settings.media_title }}</p>
                      {%- endif -%}
                      {%- if block.settings.media_text != blank -%}
                        <p class="t-body-s t-muted">{{ block.settings.media_text }}</p>
                      {%- endif -%}
                      {%- if block.settings.media_link != blank -%}
                        <a class="cta" href="{{ block.settings.media_link }}">
                          {{ block.settings.media_cta | default: 'Découvrir' }}
                          <span class="cta__arrow" aria-hidden="true"></span>
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</header>

<div class="hdr__scrim" data-scrim aria-hidden="true"></div>
{%- unless transparent -%}<div class="hdr-spacer" aria-hidden="true"></div>{%- endunless -%}

{%- comment -%}
  ---------- MENU MOBILE ----------
  Panneaux empilés (niveau 1 = racine, niveau 2 = catégorie, niveau 3 = métaux / formes / etc.).
  data-mmenu-open="<id du panneau>" ouvre un panneau et l'empile ; data-mmenu-back dépile le
  panneau courant. Toute la logique de glissement est en CSS (transform), pilotée par les
  classes .is-active / .is-back posées par maison-header.js.
{%- endcomment -%}
<div class="mmenu" id="MaisonMobileMenu" data-mmenu aria-hidden="true">
  <div class="mmenu__bar">
    <button class="hdr__util" type="button" data-mmenu-close>
      {% render 'maison-icon', icon: 'close' %}
      <span class="visually-hidden">{{ 'header.close_menu' | t: default: 'Fermer le menu' }}</span>
    </button>
    <span class="hdr__logo-mark" style="width:auto">{{ section.settings.logo_text | default: shop.name }}</span>
    <a class="hdr__util" href="{{ routes.cart_url }}" data-cart-open>
      {% render 'maison-icon', icon: 'bag' %}
      <span class="visually-hidden">{{ 'header.cart' | t: default: 'Panier' }}</span>
      <span class="hdr__count" data-header-cart-count aria-hidden="true" {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>

  <div class="mmenu__viewport" data-mmenu-viewport>
    {%- comment -%} ---- Niveau 1 : racine ---- {%- endcomment -%}
    <div class="mmenu__panel mmenu__panel--root is-active" data-mmenu-panel="mmenu-root" data-depth="0" id="mmenu-root">
      <ul class="mmenu__list">
        {%- for link in menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <button class="mmenu__row" type="button" data-mmenu-open="mmenu-{{ link.handle }}" style="--i: {{ forloop.index0 }}">
                <span class="mmenu__row-label">{{ link.title }}</span>
                <span class="mmenu__chev" aria-hidden="true"></span>
              </button>
            {%- else -%}
              <a class="mmenu__row" href="{{ link.url }}" style="--i: {{ forloop.index0 }}">
                <span class="mmenu__row-label">{{ link.title }}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <div class="mmenu__secondary">
        {%- if shop.customer_accounts_enabled -%}
          <a class="mmenu__row mmenu__row--quiet" href="{{ routes.account_url }}">
            <span class="mmenu__row-label t-label">{{ 'header.account' | t: default: 'Mon compte' }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.wishlist_link != blank -%}
          <a class="mmenu__row mmenu__row--quiet" href="{{ section.settings.wishlist_link }}">
            <span class="mmenu__row-label t-label">{{ 'header.wishlist' | t: default: 'Favoris' }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.contact_link != blank -%}
          <a class="mmenu__row mmenu__row--quiet" href="{{ section.settings.contact_link }}">
            <span class="mmenu__row-label t-label">{{ 'header.contact' | t: default: 'Nous contacter' }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.show_localization and localization.available_countries.size > 1 -%}
          {%- form 'localization', class: 'mmenu__row mmenu__row--quiet mmenu__locale' -%}
            <label class="mmenu__row-label t-label" for="MaisonCountryMobile">{{ 'header.language' | t: default: 'Langue' }}</label>
            <select class="mmenu__locale-select" id="MaisonCountryMobile" name="country_code" aria-label="{{ 'header.country' | t: default: 'Pays / région' }}">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }}</option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---- Niveaux 2 et 3 : générés depuis les liens ayant des enfants ---- {%- endcomment -%}
    {%- for link in menu.links -%}
      {%- if link.links.size > 0 -%}
        {%- liquid
          assign panel_block = nil
          for b in section.blocks
            assign h = b.settings.parent_handle | strip | downcase
            if h == link.handle
              assign panel_block = b
            endif
          endfor
          assign inline_handles = ''
          if panel_block
            assign inline_handles = panel_block.settings.inline_group_handles | strip | downcase
          endif
          assign inline_list = inline_handles | split: ','
        -%}
        <div class="mmenu__panel" data-mmenu-panel="mmenu-{{ link.handle }}" data-depth="1" id="mmenu-{{ link.handle }}" aria-hidden="true">
          <div class="mmenu__panel-head">
            <button class="mmenu__back t-label" type="button" data-mmenu-back>
              <span class="mmenu__chev mmenu__chev--back" aria-hidden="true"></span>
              {{ 'general.back' | t: default: 'Retour' }}
            </button>
            <button class="mmenu__x" type="button" data-mmenu-close>
              {% render 'maison-icon', icon: 'close' %}
              <span class="visually-hidden">{{ 'header.close_menu' | t: default: 'Fermer le menu' }}</span>
            </button>
          </div>

          {%- if panel_block and panel_block.settings.image != blank -%}
            <div class="mmenu__hero">
              <div class="mega__frame">
                {{ panel_block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '100vw', widths: '480,700,900', alt: link.title }}
              </div>
              <span class="mmenu__hero-title t-h2">{{ link.title }}</span>
            </div>
          {%- else -%}
            <p class="mmenu__panel-title t-h2">{{ link.title }}</p>
          {%- endif -%}

          <a class="mmenu__viewall link-rule t-label" href="{{ link.url }}">
            {%- if panel_block and panel_block.settings.view_all_label != blank -%}
              {{ panel_block.settings.view_all_label }}
            {%- else -%}
              {{ 'header.view_all' | t: default: 'Voir tout' }} — {{ link.title }}
            {%- endif -%}
          </a>

          <ul class="mmenu__list">
            {%- for sub in link.links -%}
              {%- assign sub_handle = sub.handle | downcase -%}
              {%- if inline_list contains sub_handle -%}
                <li class="mmenu__group">
                  <p class="mmenu__group-title t-label">{{ sub.title }}</p>
                  <ul class="mmenu__list mmenu__list--nested">
                    {%- for leaf in sub.links -%}
                      <li>
                        <a class="mmenu__row mmenu__row--nested" href="{{ leaf.url }}">
                          <span class="mmenu__row-label">{{ leaf.title }}</span>
                          <span class="mmenu__chev" aria-hidden="true"></span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </li>
              {%- elsif sub.links.size > 0 -%}
                <li>
                  <button class="mmenu__row" type="button" data-mmenu-open="mmenu-{{ link.handle }}-{{ sub_handle }}">
                    <span class="mmenu__row-label">{{ sub.title }}</span>
                    <span class="mmenu__chev" aria-hidden="true"></span>
                  </button>
                </li>
              {%- else -%}
                <li>
                  <a class="mmenu__row" href="{{ sub.url }}">
                    <span class="mmenu__row-label">{{ sub.title }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          {%- if panel_block and panel_block.settings.guide_1_image != blank or panel_block.settings.guide_2_image != blank -%}
            {%- liquid
              assign guides_title = panel_block.settings.guides_title
              if guides_title == blank
                assign guides_title = 'header.guides' | t: default: 'Guides'
              endif
            -%}
            <div class="mmenu__guides">
              <p class="mmenu__group-title t-label">{{ guides_title }}</p>
              <div class="mmenu__guides-grid">
                {%- if panel_block.settings.guide_1_image != blank -%}
                  <a class="mmenu__guide-card" href="{{ panel_block.settings.guide_1_link | default: '#' }}">
                    <span class="mmenu__guide-frame">
                      {{ panel_block.settings.guide_1_image | image_url: width: 500 | image_tag: loading: 'lazy', sizes: '50vw', widths: '260,400,500' }}
                    </span>
                    <span class="mmenu__guide-title t-label">{{ panel_block.settings.guide_1_title }}</span>
                  </a>
                {%- endif -%}
                {%- if panel_block.settings.guide_2_image != blank -%}
                  <a class="mmenu__guide-card" href="{{ panel_block.settings.guide_2_link | default: '#' }}">
                    <span class="mmenu__guide-frame">
                      {{ panel_block.settings.guide_2_image | image_url: width: 500 | image_tag: loading: 'lazy', sizes: '50vw', widths: '260,400,500' }}
                    </span>
                    <span class="mmenu__guide-title t-label">{{ panel_block.settings.guide_2_title }}</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} ---- Niveau 3 : sous-catégories avec enfants (métaux, formes...) ---- {%- endcomment -%}
        {%- for sub in link.links -%}
          {%- assign sub_handle = sub.handle | downcase -%}
          {%- unless inline_list contains sub_handle -%}
            {%- if sub.links.size > 0 -%}
              {%- liquid
                assign mode = 'plain'
                if sub_handle contains 'metal' or sub_handle contains 'metau'
                  assign mode = 'metal'
                endif
                if sub_handle contains 'forme' or sub_handle contains 'shape'
                  assign mode = 'shape'
                endif
              -%}
              <div class="mmenu__panel" data-mmenu-panel="mmenu-{{ link.handle }}-{{ sub_handle }}" data-depth="2" id="mmenu-{{ link.handle }}-{{ sub_handle }}" aria-hidden="true">
                <div class="mmenu__panel-head">
                  <button class="mmenu__back t-label" type="button" data-mmenu-back>
                    <span class="mmenu__chev mmenu__chev--back" aria-hidden="true"></span>
                    {{ 'general.back' | t: default: 'Retour' }}
                  </button>
                  <button class="mmenu__x" type="button" data-mmenu-close>
                    {% render 'maison-icon', icon: 'close' %}
                    <span class="visually-hidden">{{ 'header.close_menu' | t: default: 'Fermer le menu' }}</span>
                  </button>
                </div>
                <p class="mmenu__panel-title t-h2">{{ sub.title }}</p>
                <ul class="mmenu__list{% if mode != 'plain' %} mmenu__list--{{ mode }}{% endif %}">
                  {%- for leaf in sub.links -%}
                    <li>
                      <a class="mmenu__row{% if mode == 'metal' %} mmenu__row--metal{% elsif mode == 'shape' %} mmenu__row--shape{% endif %}" href="{{ leaf.url }}">
                        {%- if mode == 'metal' -%}
                          <span class="mmenu__swatch mmenu__swatch--{{ leaf.handle | downcase }}" aria-hidden="true"></span>
                        {%- elsif mode == 'shape' -%}
                          {% render 'maison-icon', icon: 'shape-' | append: leaf.handle | downcase %}
                        {%- endif -%}
                        <span class="mmenu__row-label">{{ leaf.title }}</span>
                        <span class="mmenu__chev" aria-hidden="true"></span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.appointment_link != blank -%}
    <div class="mmenu__foot">
      <a class="btn btn--line mmenu__cta" href="{{ section.settings.appointment_link }}">
        {{ section.settings.appointment_label | default: 'Prendre rendez-vous' }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "En-tête",
  "class": "maison-header-section",
  "settings": [
    { "type": "header", "content": "Identité" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "logo_text", "label": "Logo typographique (si aucune image)", "default": "MAISON" },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu principal", "default": "main-menu" },
    { "type": "url", "id": "wishlist_link", "label": "Lien Favoris", "info": "Pointez-le vers la page Favoris (modèle « favoris »). L'icône n'apparaît que si un lien est défini." },
    { "type": "url", "id": "contact_link", "label": "Lien Nous contacter", "info": "Affiché dans le pied du menu mobile." },
    { "type": "text", "id": "appointment_label", "label": "Libellé Rendez-vous", "default": "Prendre rendez-vous" },
    { "type": "url", "id": "appointment_link", "label": "Lien Rendez-vous" },
    { "type": "checkbox", "id": "show_localization", "label": "Afficher le sélecteur pays / région", "default": true },
    { "type": "header", "content": "En-tête transparent" },
    { "type": "text", "id": "transparent_templates", "label": "Modèles en en-tête transparent", "info": "Liste séparée par des virgules, ex. : index, page.maison", "default": "" },
    { "type": "checkbox", "id": "transparent_light", "label": "Logo et navigation en blanc au chargement", "default": true }
  ],
  "blocks": [
    {
      "type": "mega",
      "name": "Mega-menu",
      "settings": [
        { "type": "text", "id": "parent_handle", "label": "Handle du lien parent", "info": "Le handle du lien du menu principal qui ouvre ce panneau, ex. : bagues" },
        { "type": "header", "content": "Colonnes" },
        { "type": "text", "id": "title_1", "label": "Titre colonne 1", "default": "Découvrir" },
        { "type": "link_list", "id": "menu_1", "label": "Menu colonne 1" },
        { "type": "text", "id": "title_2", "label": "Titre colonne 2", "default": "Par style" },
        { "type": "link_list", "id": "menu_2", "label": "Menu colonne 2" },
        { "type": "text", "id": "title_3", "label": "Titre colonne 3", "default": "Par métal" },
        { "type": "link_list", "id": "menu_3", "label": "Menu colonne 3" },
        { "type": "text", "id": "title_4", "label": "Titre colonne 4", "default": "Par pierre" },
        { "type": "link_list", "id": "menu_4", "label": "Menu colonne 4" },
        { "type": "header", "content": "Éditorial" },
        { "type": "image_picker", "id": "image", "label": "Image principale" },
        { "type": "image_picker", "id": "image_2", "label": "Image secondaire" },
        { "type": "url", "id": "image_link", "label": "Lien de l'image" },
        { "type": "text", "id": "media_title", "label": "Titre", "default": "La Collection" },
        { "type": "text", "id": "media_text", "label": "Texte" },
        { "type": "text", "id": "media_cta", "label": "Libellé du lien", "default": "Découvrir" },
        { "type": "url", "id": "media_link", "label": "Lien" },
