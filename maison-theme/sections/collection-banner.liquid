{%- comment -%}
  Bandeau de collection. Une seule architecture pour toutes les collections :
  l'image, le titre et le texte viennent de la collection Shopify elle-même,
  donc chaque collection a son propre contenu sans template dédié.
{%- endcomment -%}
{%- liquid
  assign image = collection.image
  if section.settings.image_override != blank
    assign image = section.settings.image_override
  endif
  assign heading = section.settings.heading | default: collection.title
-%}

<section class="cbanner{% unless image %} cbanner--plain{% endunless %}">
  {%- if image -%}
    <div class="cbanner__media">
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
          {{ image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800,1200,1800,2400', alt: image.alt | default: collection.title }}
        </picture>
      {%- else -%}
        {{ image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800,1200,1800,2400', alt: image.alt | default: collection.title }}
      {%- endif -%}
    </div>
    <div class="cbanner__veil" aria-hidden="true"></div>
  {%- endif -%}

  <div class="cbanner__inner page">
    {%- if section.settings.show_breadcrumb -%}
      {% render 'maison-breadcrumb',
        current_title: collection.title,
        parent_title: section.settings.parent_title,
        parent_url: section.settings.parent_link,
        on_dark: image %}
    {%- endif -%}

    <h1 class="t-display cbanner__title line-mask" data-reveal="mask"><span>{{ heading }}</span></h1>

    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="t-body cbanner__text" data-reveal style="--i: 1">{{ collection.description }}</div>
    {%- elsif section.settings.text != blank -%}
      <p class="t-body cbanner__text" data-reveal style="--i: 1">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.cta_link != blank and section.settings.cta_label != blank -%}
      <div class="cbanner__cta" data-reveal style="--i: 2">
        <a class="cta" href="{{ section.settings.cta_link }}">
          {{ section.settings.cta_label }}<span class="cta__arrow" aria-hidden="true"></span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bandeau de collection",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "L'image et le texte viennent de la fiche de la collection dans Shopify (Produits → Collections). Les réglages ci-dessous ne servent qu'à surcharger ce contenu." },
    { "type": "image_picker", "id": "image_override", "label": "Image desktop (remplace celle de la collection)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image mobile" },
    { "type": "text", "id": "heading", "label": "Titre (remplace le nom de la collection)" },
    { "type": "checkbox", "id": "show_description", "label": "Afficher la description de la collection", "default": true },
    { "type": "textarea", "id": "text", "label": "Texte de repli", "info": "Utilisé si la collection n'a pas de description." },
    { "type": "text", "id": "cta_label", "label": "Libellé du lien" },
    { "type": "url", "id": "cta_link", "label": "Lien" },
    { "type": "header", "content": "Fil d'Ariane" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Afficher le fil d'Ariane", "default": true },
    { "type": "text", "id": "parent_title", "label": "Niveau intermédiaire", "info": "Ex. : Joaillerie" },
    { "type": "url", "id": "parent_link", "label": "Lien du niveau intermédiaire" }
  ],
  "presets": [{ "name": "Bandeau de collection" }]
}
{% endschema %}
