{%- comment -%}
  Accès secondaires en filets (Solitaires, Les formes, Guide des tailles,
  Prendre rendez-vous…). Un bloc = une destination réelle.
{%- endcomment -%}
<section class="lgrid">
  <div class="page">
    {%- if section.settings.title != blank -%}
      <div class="lgrid__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="t-label eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="t-h2 line-mask" style="margin-top: var(--s-4)" data-reveal="mask"><span>{{ section.settings.title }}</span></h2>
      </div>
    {%- endif -%}

    <div class="lgrid__list">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a class="lgrid__row" href="{{ block.settings.link }}" {{ block.shopify_attributes }} data-reveal style="--i: {{ forloop.index0 }}">
            <span class="lgrid__name">{{ block.settings.title }}</span>
            <span class="lgrid__text">{{ block.settings.text }}</span>
            <span class="cta">{{ block.settings.cta_label | default: 'Découvrir' }}<span class="cta__arrow" aria-hidden="true"></span></span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Accès en filets",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "text", "id": "title", "label": "Titre" }
  ],
  "blocks": [
    {
      "type": "acces",
      "name": "Accès",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "text", "id": "cta_label", "label": "Libellé du lien", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien", "info": "Sans lien, l'accès n'est pas affiché." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Accès en filets" }]
}
{% endschema %}
