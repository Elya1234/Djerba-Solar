{%- liquid
  assign has_video = false
  if section.settings.video != blank
    assign has_video = true
  endif
-%}

<section
  class="hero hero--{{ section.settings.position }}"
  data-hero
  data-header-contrast="light"
  aria-label="{{ section.settings.title | default: shop.name | escape }}"
>
  <div class="hero__media">
    {%- if has_video -%}
      {{ section.settings.video | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
    {%- elsif section.settings.image_desktop != blank -%}
      {%- assign img = section.settings.image_desktop -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}">
          {{ img | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800,1200,1800,2400', alt: section.settings.image_alt }}
        </picture>
      {%- else -%}
        {{ img | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800,1200,1800,2400', alt: section.settings.image_alt }}
      {%- endif -%}
    {%- else -%}
      {% render 'maison-placeholder', label: 'Hero — image ou vidéo', variant: 'dark' %}
    {%- endif -%}
  </div>

  <div class="hero__veil" aria-hidden="true" style="opacity: {{ section.settings.veil | divided_by: 100.0 }}"></div>

  <div class="hero__inner page">
    {%- if section.settings.eyebrow != blank -%}
      <p class="t-label hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h1 class="t-display hero__title">{{ section.settings.title }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="t-body hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.cta_link != blank and section.settings.cta_label != blank -%}
      <div class="hero__cta">
        <a class="cta" href="{{ section.settings.cta_link }}">
          {{ section.settings.cta_label }}<span class="cta__arrow" aria-hidden="true"></span>
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_scroll -%}
    <div class="hero__scroll" aria-hidden="true"><span></span></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Média" },
    { "type": "image_picker", "id": "image_desktop", "label": "Image desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image mobile" },
    { "type": "video", "id": "video", "label": "Vidéo", "info": "Prioritaire sur les images. Muette, en boucle, sans contrôles." },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif" },
    { "type": "range", "id": "veil", "label": "Voile sombre", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "text", "id": "title", "label": "Titre", "default": "L'éclat d'une signature" },
    { "type": "textarea", "id": "text", "label": "Phrase" },
    { "type": "text", "id": "cta_label", "label": "Libellé du lien", "default": "Découvrir la collection" },
    { "type": "url", "id": "cta_link", "label": "Lien" },
    { "type": "select", "id": "position", "label": "Position du texte", "default": "bottom-left",
      "options": [
        { "value": "bottom-left", "label": "Bas gauche" },
        { "value": "bottom-center", "label": "Bas centre" },
        { "value": "center", "label": "Centre" },
        { "value": "center-left", "label": "Centre gauche" }
      ]
    },
    { "type": "checkbox", "id": "show_scroll", "label": "Afficher l'indicateur de défilement", "default": true }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
