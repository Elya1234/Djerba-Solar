      {
        "type": "color",
        "id": "c_paper",
        "label": "Fond — blanc gemme",
        "default": "#FAFAF8"
      },
      {
        "type": "color",
        "id": "c_surface",
        "label": "Surfaces — blanc pur",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "c_ink",
        "label": "Encre — noir onyx",
        "default": "#111013"
      },
      {
        "type": "color",
        "id": "c_ink_soft",
        "label": "Encre secondaire — cendre",
        "default": "#6E6A65"
      },
      {
        "type": "color",
        "id": "c_line",
        "label": "Filets",
        "default": "#E4E1DA"
      },
      {
        "type": "color",
        "id": "c_signature",
        "label": "Couleur de Maison — malachite",
        "default": "#1A3A31"
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_display",
        "label": "Titres éditoriaux",
        "default": "playfair_display_n4"
      },
      {
        "type": "text",
        "id": "font_display_custom",
        "label": "Police de titres personnalisée",
        "info": "Nom exact de la famille si vous chargez une police propriétaire (Adobe Fonts, hébergée). Prioritaire sur le choix ci-dessus."
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Texte et interface",
        "default": "assistant_n4"
      },
      {
        "type": "text",
        "id": "font_body_custom",
        "label": "Police de texte personnalisée"
      },
      {
        "type": "range",
        "id": "ls_nav",
        "label": "Interlettrage navigation",
        "min": 0.08,
        "max": 0.3,
        "step": 0.01,
        "unit": "em",
        "default": 0.16
      },
      {
        "type": "range",
        "id": "ls_label",
        "label": "Interlettrage labels",
        "min": 0.1,
        "max": 0.4,
        "step": 0.01,
        "unit": "em",
        "default": 0.22
      }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      {
        "type": "range",
        "id": "max_width",
        "label": "Largeur maximale",
        "min": 1280,
        "max": 1920,
        "step": 40,
        "unit": "px",
        "default": 1680
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Mouvement",
    "settings": [
      {
        "type": "paragraph",
        "content": "Durée de référence du langage d'animation. Les autres durées en sont dérivées, ce qui garde toutes les transitions du site cohérentes entre elles."
      },
      {
        "type": "range",
        "id": "motion_speed",
        "label": "Durée de référence",
        "min": 240,
        "max": 640,
        "step": 20,
        "unit": "ms",
        "default": 420
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "text",
        "id": "cart_empty_text",
        "label": "Texte du panier vide"
